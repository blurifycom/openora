// -- packages/modules/bonus/prisma.partial.prisma --

enum BonusType {
  welcome
  deposit_match
  free_spins
  custom
}

enum UserBonusStatus {
  pending
  active
  completed
  expired
  cancelled
}

model Bonus {
  id              String      @id @default(cuid())
  tenantId        String
  type            BonusType
  name            String
  description     String?
  amount          Decimal
  minDeposit      Decimal     @default(0)
  wagerMultiplier Int         @default(1)
  isActive        Boolean     @default(true)
  expiresAt       DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  userBonuses     UserBonus[]

  @@index([tenantId, isActive])
  @@map("bonus")
}

model UserBonus {
  id              String          @id @default(cuid())
  tenantId        String
  userId          String
  bonusId         String
  status          UserBonusStatus @default(pending)
  awardedAmount   Decimal
  wageredAmount   Decimal         @default(0)
  wagerRequirement Decimal
  expiresAt       DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  bonus           Bonus           @relation(fields: [bonusId], references: [id])

  @@index([tenantId, userId])
  @@index([bonusId])
  @@map("user_bonus")
}

