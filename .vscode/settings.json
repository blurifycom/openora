{
  // Shared workspace settings for contributors. Personal preferences (fonts,
  // theme, keybindings, AI tooling) belong in your User settings, not here.

  // --- Code style: match the repo's tooling (oxlint + oxfmt via the oxc ext) ---
  "editor.formatOnSave": true,
  "editor.defaultFormatter": "oxc.oxc-vscode",
  "editor.codeActionsOnSave": {
    "source.fixAll.oxc": "always"
  },

  // --- Whitespace hygiene (CI/oxfmt expect a trailing newline, no trailing ws) ---
  "files.insertFinalNewline": true,
  "files.trimTrailingWhitespace": true,
  "files.trimTrailingWhitespaceInRegexAndStrings": false,

  // --- TypeScript in a pnpm/turbo monorepo ---
  "js/ts.preferences.includePackageJsonAutoImports": "on",
  "js/ts.updateImportsOnFileMove.enabled": "always",

  // --- Search/editor niceties ---
  "search.smartCase": true,
  "markdown.updateLinksOnFileMove.enabled": "always"
}
