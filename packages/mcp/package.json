{
  "name": "@openora/mcp",
  "version": "0.3.0",
  "description": "MCP server exposing the Openora iGaming framework catalog (routes, schemas, adapter seams, events) to AI coding agents in consumer repos",
  "keywords": [
    "ai-native",
    "igaming",
    "mcp",
    "model-context-protocol",
    "openora"
  ],
  "homepage": "https://github.com/blurifycom/openora",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/blurifycom/openora.git",
    "directory": "packages/mcp"
  },
  "bin": "./dist/main.js",
  "files": [
    "dist",
    "docs",
    "agents"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "@openora/core": "workspace:*",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "25.9.2",
    "typescript": "6.0.3"
  }
}
