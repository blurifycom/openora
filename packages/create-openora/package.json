{
  "name": "@openora/create",
  "version": "0.4.0",
  "description": "npm initializer that scaffolds a headless Openora consumer app from the published @openora/* packages - no OSS checkout required",
  "keywords": [
    "ai-native",
    "create",
    "igaming",
    "openora",
    "scaffold"
  ],
  "homepage": "https://github.com/blurifycom/openora",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/blurifycom/openora.git",
    "directory": "packages/create-openora"
  },
  "bin": {
    "create-openora": "dist/index.js"
  },
  "files": [
    "dist",
    "template"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/copy-template.mjs && node scripts/generate-core-version.mjs && tsc",
    "typecheck": "node scripts/generate-core-version.mjs && tsc --noEmit",
    "clean": "rm -rf dist template src/generated",
    "prepack": "pnpm run build"
  },
  "devDependencies": {
    "@openora/core": "workspace:*",
    "@types/node": "25.9.2",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=26"
  }
}
