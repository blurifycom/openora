import * as pulumi from "@pulumi/pulumi";
import * as aws from "@pulumi/aws";

import { settings, dbPassword } from "./config";
import { vpc, dbSg, redisSg } from "./network";

// Data layer: RDS Postgres 16 + a single-node ElastiCache Redis, both in the private
// subnets and reachable only from the app SG. Exports the connection URLs (as Pulumi
// Outputs, with the secret password interpolated) for the services layer to inject.

const dbSubnetGroup = new aws.rds.SubnetGroup("db", {
  subnetIds: vpc.privateSubnetIds,
});

export const db = new aws.rds.Instance("db", {
  engine: "postgres",
  engineVersion: "16",
  instanceClass: settings.dbInstanceClass,
  allocatedStorage: 20,
  dbName: settings.dbName,
  username: settings.dbUser,
  password: dbPassword,
  dbSubnetGroupName: dbSubnetGroup.name,
  vpcSecurityGroupIds: [dbSg.id],
  skipFinalSnapshot: true,
  publiclyAccessible: false,
});

const redisSubnetGroup = new aws.elasticache.SubnetGroup("redis", {
  subnetIds: vpc.privateSubnetIds,
});

export const redis = new aws.elasticache.ReplicationGroup("redis", {
  description: "{{kebabCase name}} redis",
  engine: "redis",
  nodeType: settings.redisNodeType,
  numCacheClusters: 1,
  port: 6379,
  subnetGroupName: redisSubnetGroup.name,
  securityGroupIds: [redisSg.id],
  atRestEncryptionEnabled: true,
});

export const dbEndpoint = db.address;
export const redisEndpoint = redis.primaryEndpointAddress;

export const databaseUrl: pulumi.Output<string> = pulumi.interpolate`postgresql://${settings.dbUser}:${dbPassword}@${db.address}:${db.port}/${settings.dbName}`;

export const redisUrl: pulumi.Output<string> = pulumi.interpolate`redis://${redis.primaryEndpointAddress}:6379`;
