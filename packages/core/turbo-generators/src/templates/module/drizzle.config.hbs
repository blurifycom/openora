import 'dotenv/config';
import { defineConfig } from 'drizzle-kit';

// This add-on owns its migration history + tracking table. One database shared with
// sibling modules, but one journal per module so it can be installed or extracted
// independently without history surgery. See ADR-0020/0027.
export default defineConfig({
  dialect: 'postgresql',
  casing: 'snake_case',
  schema: ['./src/schema/index.ts'],
  out: './drizzle/migrations',
  migrations: {
    table: '__drizzle_migrations_addon_{{snakeCase name}}',
    schema: 'drizzle',
  },
  dbCredentials: {
    url:
      process.env['DATABASE_ADMIN_URL'] ??
      process.env['DATABASE_URL'] ??
      'postgresql://postgres:postgres@localhost:5432/oss_igaming',
  },
});
