import { pgTable, text, timestamp, index } from 'drizzle-orm/pg-core';
import { createId } from '@paralleldrive/cuid2';

// Drizzle tables owned by the {{pascalCase name}} module.
// Rules:
//   - Every multi-tenant table MUST include a `tenantId` column (lint: require-tenant-id).
//   - Do NOT add FK references to tables owned by other modules - reference by id.
//   - Table names are snake_case; exported consts are camelCase.
export const {{camelCase name}} = pgTable(
  '{{snakeCase name}}',
  {
    id: text('id')
      .primaryKey()
      .$defaultFn(() => createId()),
    tenantId: text('tenantId').notNull(),
    createdAt: timestamp('createdAt').notNull().defaultNow(),
  },
  (t) => [index('{{snakeCase name}}_tenantId_idx').on(t.tenantId)],
);

export type {{pascalCase name}} = typeof {{camelCase name}}.$inferSelect;
