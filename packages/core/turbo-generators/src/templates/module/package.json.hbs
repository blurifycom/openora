{
  "name": "@blurifycom-addons/{{kebabCase name}}",
  "version": "0.0.1",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema/index.d.ts",
      "import": "./dist/schema/index.js",
      "default": "./dist/schema/index.js"
    },
    "./plugin": {
      "types": "./dist/plugin.d.ts",
      "import": "./dist/plugin.js",
      "default": "./dist/plugin.js"
    },
    "./migrate": {
      "types": "./dist/migrate.d.ts",
      "import": "./dist/migrate.js",
      "default": "./dist/migrate.js"
    }
  },
  "files": ["dist", "drizzle"],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "generate": "drizzle-kit generate",
    "test": "vitest run",
    "test:unit": "vitest run --passWithNoTests",
    "test:integration": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@orpc/contract": "1.14.5",
    "@orpc/server": "1.14.5",
    "@blurifycom/adapters": "workspace:*",
    "@blurifycom/auth": "workspace:*",
    "@blurifycom/core": "workspace:*",
    "@blurifycom/db": "workspace:*",
    "@blurifycom/orpc-contract": "workspace:*",
    "@blurifycom/plugin-host": "workspace:*",
    "@blurifycom/shared-schemas": "workspace:*",
    "@paralleldrive/cuid2": "3.3.0",
    "drizzle-orm": "0.45.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@blurifycom/vitest-config": "workspace:*",
    "@types/node": "25.9.2",
    "drizzle-kit": "0.31.10",
    "typescript": "6.0.3",
    "vitest": "4.1.8"
  }
}
