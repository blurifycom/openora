import { definePlugin } from '@blurifycom/plugin-host';
import { EVENT_BUS } from '@blurifycom/core';
import { DRIZZLE } from '@blurifycom/db';
import { {{pascalCase name}}Service } from './service/{{kebabCase name}}.service.js';
import { create{{pascalCase name}}Router } from './router/index.js';

// DI wiring only - no business logic here. The router factory resolves deps from
// the container at boot (after every plugin registered), so an overlay can rebind
// an adapter token (last registration wins) without a fork.
export default definePlugin({
  id: '{{kebabCase name}}',
  // dependsOn: ['identity'], // declare deps so the loader boots them first
  register(ctx) {
    // AGENT: bind any vendor adapters before mounting the router, e.g.
    //   ctx.provide(SOME_ADAPTER, () => new MockSomeAdapter());
    ctx.routers.add('{{camelCase name}}', (c) =>
      create{{pascalCase name}}Router(new {{pascalCase name}}Service(c.get(DRIZZLE), c.get(EVENT_BUS))),
    );
  },
});
