{
  "$schema": "https://raw.githubusercontent.com/oxc-project/oxc/main/crates/oxc_linter/src/options/oxlintrc.json",
  "plugins": ["typescript", "import", "unicorn", "oxc"],
  "rules": {
    "no-unused-vars": "error",
    "no-console": "warn",
    "eqeqeq": "error",
    "no-var": "error",
    "prefer-const": "error",
    "typescript/no-explicit-any": "error",
    "typescript/no-non-null-assertion": "error",
    "typescript/consistent-type-definitions": ["error", "type"],
    "import/no-cycle": ["error", { "ignoreTypes": false }],
    "import/no-duplicates": "error"
  },
  "ignorePatterns": ["node_modules", "dist", ".next", "coverage", "*.generated.ts"],
  "overrides": [
    {
      "files": ["*.test.ts", "*.spec.ts", "**/__tests__/**"],
      "rules": {
        "typescript/no-explicit-any": "off",
        "typescript/no-non-null-assertion": "off"
      }
    }
  ]
}
