  },
  "devDependencies": {
    "@oss/tsconfig": "workspace:*",
    "@oss/vitest-config": "workspace:*",
    "typescript": "6.0.3",
    "vitest": "4.1.6"
  },
  "peerDependencies": {
    "reflect-metadata": ">=0.1.0"
