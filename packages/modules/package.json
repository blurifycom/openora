{
  "name": "@oss/modules",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "exports": {
    "./*": {
      "types": "./dist/*/src/index.d.ts",
      "import": "./dist/*/src/index.js",
      "default": "./dist/*/src/index.js"
    },
    "./*/schema": {
      "types": "./dist/*/src/schema/index.d.ts",
      "import": "./dist/*/src/schema/index.js",
      "default": "./dist/*/src/schema/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:unit": "vitest run --passWithNoTests",
    "test:integration": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@orpc/contract": "1.14.5",
    "@orpc/server": "1.14.5",
    "@oss/adapters": "workspace:*",
    "@oss/auth": "workspace:*",
    "@oss/core": "workspace:*",
    "@oss/db": "workspace:*",
    "@oss/orpc-contract": "workspace:*",
    "@oss/plugin-host": "workspace:*",
    "@oss/shared-schemas": "workspace:*",
    "@paralleldrive/cuid2": "3.3.0",
    "better-auth": "1.6.15",
    "drizzle-orm": "0.45.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@oss/tsconfig": "workspace:*",
    "@oss/vitest-config": "workspace:*",
    "@types/node": "25.9.2",
    "@types/react": "19.2.17",
    "react": "19.2.7",
    "typescript": "6.0.3",
    "vitest": "4.1.8"
  },
  "peerDependencies": {
    "react": ">=19.0.0"
  }
}
