// Tables owned by the compliance module.
// Merged into infra/prisma/schema.prisma by `pnpm regen`.

model UserLimit {
  id        String   @id @default(cuid())
  userId    String
  type      String
  amount    Float
  period    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, type, period])
  @@index([userId])
  @@map("user_limit")
}

model GeoRule {
  id          String   @id @default(cuid())
  countryCode String   @unique
  action      String
  createdAt   DateTime @default(now())

  @@map("geo_rule")
}
