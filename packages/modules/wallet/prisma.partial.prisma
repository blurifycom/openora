// Tables owned by the wallet module.
// Merged into infra/prisma/schema.prisma by `pnpm regen`.
// Rules: every multi-tenant model must have: tenantId  String

enum WalletTransactionType {
  deposit
  withdrawal
  bet
  win
}

enum WalletTransactionStatus {
  pending
  completed
  failed
}

model Wallet {
  id        String   @id @default(cuid())
  userId    String   @unique
  tenantId  String
  balance   Decimal  @default(0)
  currency  String   @default("USD")
  updatedAt DateTime @updatedAt

  transactions WalletTransaction[]

  @@index([tenantId])
  @@map("wallet")
}

model WalletTransaction {
  id        String                  @id @default(cuid())
  walletId  String
  tenantId  String
  type      WalletTransactionType
  amount    Decimal
  currency  String
  status    WalletTransactionStatus @default(pending)
  metadata  Json?
  createdAt DateTime                @default(now())

  wallet Wallet @relation(fields: [walletId], references: [id])

  @@index([walletId])
  @@index([tenantId])
  @@map("wallet_transaction")
}
