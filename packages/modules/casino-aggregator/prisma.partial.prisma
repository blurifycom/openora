// Tables owned by the casino-aggregator module.
// Merged into infra/prisma/schema.prisma by `pnpm regen`.

model AggregatorProvider {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  slug      String
  isActive  Boolean  @default(true)
  config    Json?
  createdAt DateTime @default(now())

  @@unique([tenantId, slug])
  @@map("aggregator_provider")
}
