// Tables owned by the gaming module.
// Merged into infra/prisma/schema.prisma by `pnpm regen`.
// Rules: every multi-tenant model must have: tenantId  String

enum GameRoundStatus {
  active
  completed
  cancelled
}

model Game {
  id           String    @id @default(cuid())
  tenantId     String
  name         String
  provider     String
  category     String
  thumbnailUrl String?
  isActive     Boolean   @default(true)
  metadata     Json?
  createdAt    DateTime  @default(now())
  rounds       GameRound[]

  @@index([tenantId])
}

model GameRound {
  id         String          @id @default(cuid())
  tenantId   String
  gameId     String
  userId     String
  status     GameRoundStatus @default(active)
  betAmount  Decimal         @default(0)
  winAmount  Decimal         @default(0)
  currency   String
  startedAt  DateTime        @default(now())
  endedAt    DateTime?
  game       Game            @relation(fields: [gameId], references: [id])

  @@index([tenantId])
  @@index([userId])
}
