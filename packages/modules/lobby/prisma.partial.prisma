// Tables owned by the lobby module.
// Merged into infra/prisma/schema.prisma by `pnpm regen`.
// Rules: every multi-tenant model must have: tenantId  String

model LobbyCategory {
  id        String              @id @default(cuid())
  tenantId  String
  name      String
  slug      String
  sortOrder Int                 @default(0)
  createdAt DateTime            @default(now())
  games     LobbyCategoryGame[]

  @@unique([tenantId, slug])
  @@index([tenantId])
}

model LobbyCategoryGame {
  id         String       @id @default(cuid())
  categoryId String
  gameId     String
  sortOrder  Int          @default(0)
  category   LobbyCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([categoryId])
}

model FeaturedSlot {
  id        String   @id @default(cuid())
  tenantId  String
  gameId    String
  title     String
  placement String
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([tenantId])
}
