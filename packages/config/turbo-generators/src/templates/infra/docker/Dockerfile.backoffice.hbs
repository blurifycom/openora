# syntax=docker/dockerfile:1
# Vite 8 React SPA. Build context holds BOTH repos:
#   <context>/igaming-oss  +  <context>/{{kebabCase name}}
# VITE_PUBLIC_API_URL is baked at BUILD time (public env), so it is a build arg.
# Runtime is nginx serving the static dist/.

FROM node:26-slim AS base
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
RUN corepack enable && corepack prepare pnpm@11.8.0 --activate
WORKDIR /app

# --- build -------------------------------------------------------------------
FROM base AS build
ARG VITE_PUBLIC_API_URL
ENV VITE_PUBLIC_API_URL=${VITE_PUBLIC_API_URL}

COPY igaming-oss/ ./igaming-oss/
COPY {{kebabCase name}}/ ./{{kebabCase name}}/

WORKDIR /app/{{kebabCase name}}
RUN pnpm install --frozen-lockfile
RUN pnpm -C ../igaming-oss install --frozen-lockfile && pnpm build:oss
RUN pnpm -F backoffice build

# --- runtime (nginx static) --------------------------------------------------
FROM nginx:alpine AS runtime
COPY {{kebabCase name}}/infra/docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/{{kebabCase name}}/apps/backoffice/dist /usr/share/nginx/html
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
