# syntax=docker/dockerfile:1
# Build context = the dir holding BOTH repos side by side:
#   <context>/igaming-oss   (the platform, linked via pnpm-workspace overrides)
#   <context>/{{kebabCase name}}        (this consumer repo)
# The api runs TypeScript directly via tsx - no compile step, only deps + the OSS build.

FROM node:26-slim AS base
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
RUN corepack enable && corepack prepare pnpm@11.8.0 --activate
WORKDIR /app

# --- deps + oss build --------------------------------------------------------
FROM base AS build
# Copy both repos. Order: platform first so consumer links resolve.
COPY igaming-oss/ ./igaming-oss/
COPY {{kebabCase name}}/ ./{{kebabCase name}}/

WORKDIR /app/{{kebabCase name}}
# Resolves @oss/* links into ../igaming-oss via pnpm-workspace overrides.
RUN pnpm install --frozen-lockfile
# Build the linked platform packages the api imports at runtime.
RUN pnpm -C ../igaming-oss install --frozen-lockfile && pnpm build:oss

# --- runtime -----------------------------------------------------------------
# api runs from source with tsx; we keep the whole built workspace.
FROM build AS runtime
ENV NODE_ENV=production
ENV PORT=3001
WORKDIR /app/{{kebabCase name}}
EXPOSE 3001
CMD ["node", "--import", "tsx", "apps/api/src/main.ts"]
