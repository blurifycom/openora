import * as pulumi from "@pulumi/pulumi";
import * as z from "zod";

// Zod-first config (repo convention). Non-secret values are read off the Pulumi
// config, validated by Zod, and exported as a plain typed object. Secrets stay as
// Pulumi Outputs - we never pass Outputs through Zod (they are not plain strings at
// graph-build time); they are resolved lazily by Pulumi during `up`.

const cfg = new pulumi.Config();
const awsCfg = new pulumi.Config("aws");

const SettingsSchema = z.object({
  project: z.string().min(1),
  region: z.string().min(1),
  webDomain: z.string().min(1),
  apiDomain: z.string().min(1),
  adminDomain: z.string().min(1),
  desiredCount: z.coerce.number().int().positive().default(1),
  dbInstanceClass: z.string().min(1).default("db.t4g.micro"),
  redisNodeType: z.string().min(1).default("cache.t4g.micro"),
  dbName: z.string().min(1).default("{{kebabCase name}}"),
  dbUser: z.string().min(1).default("{{kebabCase name}}"),
});

export type Settings = z.infer<typeof SettingsSchema>;

// `Config` is the public name other modules import (the resolved settings).
export type Config = Settings;

export const settings: Settings = SettingsSchema.parse({
  project: pulumi.getProject(),
  region: cfg.get("region") ?? awsCfg.get("region") ?? "{{region}}",
  webDomain: cfg.require("webDomain"),
  apiDomain: cfg.require("apiDomain"),
  adminDomain: cfg.require("adminDomain"),
  desiredCount: cfg.get("desiredCount"),
  dbInstanceClass: cfg.get("dbInstanceClass"),
  redisNodeType: cfg.get("redisNodeType"),
  dbName: cfg.get("dbName"),
  dbUser: cfg.get("dbUser"),
});

// Secrets - kept as Pulumi Outputs, resolved during `up`. Set them with:
//   pulumi config set --secret authSecret <32+ chars>
//   pulumi config set --secret dbPassword <pw>
export const authSecret: pulumi.Output<string> = cfg.requireSecret("authSecret");
export const dbPassword: pulumi.Output<string> = cfg.requireSecret("dbPassword");

// Public app URLs (https). NEXT_PUBLIC_*/VITE_PUBLIC_* are baked at BUILD time for
// web/backoffice (see README); the api receives them at runtime for CORS.
export const apiUrl = `https://${settings.apiDomain}`;
export const webUrl = `https://${settings.webDomain}`;
export const adminUrl = `https://${settings.adminDomain}`;

// CORS_ORIGINS the api accepts (comma-separated): the two browser apps.
export const corsOrigins = [webUrl, adminUrl].join(",");
