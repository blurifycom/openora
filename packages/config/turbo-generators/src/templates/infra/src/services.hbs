import * as pulumi from "@pulumi/pulumi";
import * as aws from "@pulumi/aws";
import * as awsx from "@pulumi/awsx";

import {
  settings,
  authSecret,
  apiUrl,
  corsOrigins,
} from "./config";
import { vpc, albSg, appSg } from "./network";
import { databaseUrl, redisUrl } from "./data";

// Services layer: an ECS cluster, a public ALB terminating TLS via an ACM cert, three
// container images built from the combined-repo context, and three Fargate services
// (api/web/backoffice) routed by host header. Pure wiring; outputs at the bottom.

// --- ACM certificate (DNS-validated, covers all three hostnames) -------------
// AGENT: DNS validation BLOCKS `pulumi up` until the CNAME records this cert emits
// are present in the DNS zone for the base domain. Either (a) run `pulumi up` once,
// read the validation CNAMEs from `cert.domainValidationOptions`, add them to your
// external DNS, then re-run; or (b) manage the zone in Route 53 and create the
// `aws.route53.Record` + `aws.acm.CertificateValidation` here so it self-validates.
const cert = new aws.acm.Certificate("cert", {
  domainName: settings.apiDomain,
  subjectAlternativeNames: [settings.webDomain, settings.adminDomain],
  validationMethod: "DNS",
});

// --- Load balancer -----------------------------------------------------------
const alb = new aws.lb.LoadBalancer("alb", {
  loadBalancerType: "application",
  securityGroups: [albSg.id],
  subnets: vpc.publicSubnetIds,
});

// One target group per app. Fargate tasks register here via the service load balancer
// mapping. Health checks hit the app's own port over HTTP.
function targetGroup(name: string, port: number, healthPath: string): aws.lb.TargetGroup {
  return new aws.lb.TargetGroup(name, {
    port,
    protocol: "HTTP",
    targetType: "ip",
    vpcId: vpc.vpcId,
    healthCheck: { path: healthPath, matcher: "200-399", protocol: "HTTP" },
  });
}

const apiTg = targetGroup("api-tg", 3001, "/health");
const webTg = targetGroup("web-tg", 3000, "/");
const adminTg = targetGroup("admin-tg", 80, "/");

// HTTP listener -> permanent redirect to HTTPS.
new aws.lb.Listener("http", {
  loadBalancerArn: alb.arn,
  port: 80,
  protocol: "HTTP",
  defaultActions: [
    {
      type: "redirect",
      redirect: { port: "443", protocol: "HTTPS", statusCode: "HTTP_301" },
    },
  ],
});

// HTTPS listener. Default action -> web; host-header rules route api + admin.
// AGENT: uses cert.arn directly. If you add `aws.acm.CertificateValidation`, point
// `certificateArn` at `validation.certificateArn` so the listener waits for validation.
const httpsListener = new aws.lb.Listener("https", {
  loadBalancerArn: alb.arn,
  port: 443,
  protocol: "HTTPS",
  sslPolicy: "ELBSecurityPolicy-2016-08",
  certificateArn: cert.arn,
  defaultActions: [{ type: "forward", targetGroupArn: webTg.arn }],
});

new aws.lb.ListenerRule("api-rule", {
  listenerArn: httpsListener.arn,
  priority: 10,
  actions: [{ type: "forward", targetGroupArn: apiTg.arn }],
  conditions: [{ hostHeader: { values: [settings.apiDomain] } }],
});

new aws.lb.ListenerRule("admin-rule", {
  listenerArn: httpsListener.arn,
  priority: 20,
  actions: [{ type: "forward", targetGroupArn: adminTg.arn }],
  conditions: [{ hostHeader: { values: [settings.adminDomain] } }],
});

// --- Cluster + images --------------------------------------------------------
const cluster = new aws.ecs.Cluster("cluster", {});

// `context` is the dir holding BOTH repos (igaming-oss + the consumer). From apps/infra
// that is three levels up. The Dockerfiles COPY both and build the linked workspace.
const buildContext = "../../..";

function appImage(name: string, dockerfile: string): awsx.ecr.Image {
  const repo = new awsx.ecr.Repository(name, { forceDelete: true });
  return new awsx.ecr.Image(name, {
    repositoryUrl: repo.url,
    context: buildContext,
    dockerfile,
    platform: "linux/amd64",
    // Public URLs bake at build time for the static/standalone front ends.
    args: {
      NEXT_PUBLIC_API_URL: apiUrl,
      VITE_PUBLIC_API_URL: apiUrl,
    },
  });
}

// `dockerfile` paths resolve relative to this Pulumi program dir (apps/infra).
const apiImage = appImage("api", "docker/Dockerfile.api");
const webImage = appImage("web", "docker/Dockerfile.web");
const adminImage = appImage("backoffice", "docker/Dockerfile.backoffice");

const networkConfiguration: aws.types.input.ecs.ServiceNetworkConfiguration = {
  subnets: vpc.privateSubnetIds,
  securityGroups: [appSg.id],
  assignPublicIp: false,
};

// --- API service (full runtime env) ------------------------------------------
const apiEnv = [
  { name: "PORT", value: "3001" },
  { name: "NODE_ENV", value: "production" },
  { name: "DATABASE_URL", value: databaseUrl },
  { name: "REDIS_URL", value: redisUrl },
  { name: "AUTH_SECRET", value: authSecret },
  { name: "CORS_ORIGINS", value: corsOrigins },
  { name: "NEXT_PUBLIC_API_URL", value: apiUrl },
  { name: "VITE_PUBLIC_API_URL", value: apiUrl },
];

const apiService = new awsx.ecs.FargateService("api", {
  cluster: cluster.arn,
  desiredCount: settings.desiredCount,
  networkConfiguration,
  taskDefinitionArgs: {
    containers: {
      api: {
        name: "api",
        image: apiImage.imageUri,
        cpu: 256,
        memory: 512,
        essential: true,
        portMappings: [{ containerPort: 3001, targetGroup: apiTg }],
        environment: apiEnv,
      },
    },
  },
});

const webService = new awsx.ecs.FargateService("web", {
  cluster: cluster.arn,
  desiredCount: settings.desiredCount,
  networkConfiguration,
  taskDefinitionArgs: {
    containers: {
      web: {
        name: "web",
        image: webImage.imageUri,
        cpu: 256,
        memory: 512,
        essential: true,
        portMappings: [{ containerPort: 3000, targetGroup: webTg }],
        environment: [
          { name: "PORT", value: "3000" },
          { name: "NODE_ENV", value: "production" },
          { name: "NEXT_PUBLIC_API_URL", value: apiUrl },
        ],
      },
    },
  },
});

const adminService = new awsx.ecs.FargateService("backoffice", {
  cluster: cluster.arn,
  desiredCount: settings.desiredCount,
  networkConfiguration,
  taskDefinitionArgs: {
    containers: {
      backoffice: {
        name: "backoffice",
        image: adminImage.imageUri,
        cpu: 256,
        memory: 512,
        essential: true,
        portMappings: [{ containerPort: 80, targetGroup: adminTg }],
        environment: [{ name: "VITE_PUBLIC_API_URL", value: apiUrl }],
      },
    },
  },
});

// --- Outputs -----------------------------------------------------------------
export const albDnsName = alb.dnsName;
export const apiServiceName = apiService.service.name;
export const webServiceName = webService.service.name;
export const adminServiceName = adminService.service.name;
export const apiServiceUrl = apiUrl;
export const webServiceUrl = `https://${settings.webDomain}`;
export const adminServiceUrl = `https://${settings.adminDomain}`;
export const certificateArn = cert.arn;
// AGENT: confirm these CNAMEs are added to external DNS before the cert validates.
export const certValidationRecords = cert.domainValidationOptions;
