{
  "$schema": "https://raw.githubusercontent.com/oxc-project/oxc/main/crates/oxc_linter/src/options/oxlintrc.json",
  "rules": {
    "no-unused-vars": "warn",
    "no-console": "warn",
    "eqeqeq": "error",
    "no-var": "error",
    "prefer-const": "error",
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "group": ["@oss/module-*"],
            "message": "Modules must not import other modules. Use EventBus or @oss/contracts."
          }
        ]
      }
    ]
  },
  "ignore": {
    "patterns": ["node_modules", "dist", ".next", "coverage", "*.generated.ts"]
  }
}
