{
  "name": "@oss/react-sdk",
  "version": "0.0.1",
  "private": true,
  "files": [
    "dist",
    "src/styles.css"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./server": {
      "import": "./dist/server/index.js",
      "require": "./dist/server/index.js",
      "types": "./dist/server/index.d.ts"
    },
    "./styles.css": "./src/styles.css"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "test": "vitest run"
  },
  "dependencies": {
    "@oss/shared-schemas": "workspace:*",
    "@oss/orpc-contract": "workspace:*",
    "@oss/sdk-core": "workspace:*",
    "@oss/ui-provider-contract": "workspace:*",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@oss/tsconfig": "workspace:*",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "typescript": "6.0.3"
  },
  "peerDependencies": {
    "@tanstack/react-query": ">=5",
    "next": ">=15",
    "react": ">=19",
    "react-dom": ">=19"
  },
  "peerDependenciesMeta": {
    "@tanstack/react-query": {
      "optional": true
    },
    "next": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  }
}
