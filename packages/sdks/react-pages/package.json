{
  "name": "@oss/react-pages",
  "version": "0.0.1",
  "private": true,
  "files": ["dist", "src/styles.css"],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./admin": {
      "import": "./dist/admin/index.js",
      "require": "./dist/admin/index.js",
      "types": "./dist/admin/index.d.ts"
    },
    "./player": {
      "import": "./dist/player/index.js",
      "require": "./dist/player/index.js",
      "types": "./dist/player/index.d.ts"
    },
    "./ui-plugin": {
      "import": "./dist/ui-plugin/index.js",
      "require": "./dist/ui-plugin/index.js",
      "types": "./dist/ui-plugin/index.d.ts"
    },
    "./theme": {
      "import": "./dist/theme.js",
      "require": "./dist/theme.js",
      "types": "./dist/theme.d.ts"
    },
    "./styles.css": "./src/styles.css"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "test": "vitest run"
  },
  "dependencies": {
    "@oss/shared-schemas": "workspace:*",
    "@oss/orpc-contract": "workspace:*",
    "@oss/sdk-core": "workspace:*",
    "@oss/ui-provider-contract": "workspace:*",
    "@oss/react-hooks": "workspace:*",
    "@oss/react-blocks": "workspace:*",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@oss/tsconfig": "workspace:*",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "typescript": "6.0.3"
  },
  "peerDependencies": {
    "@tanstack/react-query": ">=5",
    "next": ">=15",
    "react": ">=19",
    "react-dom": ">=19"
  },
  "peerDependenciesMeta": {
    "@tanstack/react-query": { "optional": true },
    "next": { "optional": true },
    "react": { "optional": true },
    "react-dom": { "optional": true }
  }
}
