{
  "name": "@openora/testing",
  "version": "0.4.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./seed": {
      "import": "./dist/seed.js",
      "require": "./dist/seed.js",
      "types": "./dist/seed.d.ts"
    }
  },
  "scripts": {
    "build": "tsc && tsc -p scripts",
    "check:types": "tsc --noEmit && tsc -p scripts",
    "clean": "rm -rf dist",
    "test:e2e": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@openora/core": "workspace:*",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.18",
    "pg": "8.22.0",
    "redis": "5.12.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/context-async-hooks": "2.10.0",
    "@opentelemetry/sdk-trace": "2.10.0",
    "@orpc/server": "1.15.7",
    "@orpc/shared": "1.15.7",
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "typescript": "6.0.3",
    "vitest": "4.1.12"
  }
}
