{
  "name": "@openora/testing",
  "version": "0.4.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./seed-demo-data": {
      "import": "./dist/seed-demo-data.js",
      "require": "./dist/seed-demo-data.js",
      "types": "./dist/seed-demo-data.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "check:types": "tsc --noEmit",
    "clean": "rm -rf dist",
    "test:integration": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@openora/core": "workspace:*",
    "drizzle-orm": "0.45.2",
    "hono": "4.12.34",
    "pg": "8.21.0",
    "redis": "5.12.1"
  },
  "devDependencies": {
    "@types/node": "25.9.2",
    "@types/pg": "8.20.0",
    "typescript": "6.0.3",
    "vitest": "4.1.8"
  }
}
