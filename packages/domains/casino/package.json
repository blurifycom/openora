{
  "name": "@oss/casino",
  "version": "0.2.0",
  "private": false,
  "files": [
    "dist",
    "drizzle"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js",
      "default": "./dist/server.js"
    },
    "./contracts": {
      "types": "./dist/contracts.d.ts",
      "import": "./dist/contracts.js",
      "default": "./dist/contracts.js"
    },
    "./contracts/gaming": {
      "types": "./dist/gaming/contract/index.d.ts",
      "import": "./dist/gaming/contract/index.js",
      "default": "./dist/gaming/contract/index.js"
    },
    "./contracts/lobby": {
      "types": "./dist/lobby/contract/index.d.ts",
      "import": "./dist/lobby/contract/index.js",
      "default": "./dist/lobby/contract/index.js"
    },
    "./contracts/aggregator": {
      "types": "./dist/aggregator/contract/index.d.ts",
      "import": "./dist/aggregator/contract/index.js",
      "default": "./dist/aggregator/contract/index.js"
    },
    "./schema/gaming": {
      "types": "./dist/gaming/schema/index.d.ts",
      "import": "./dist/gaming/schema/index.js",
      "default": "./dist/gaming/schema/index.js"
    },
    "./schema/lobby": {
      "types": "./dist/lobby/schema/index.d.ts",
      "import": "./dist/lobby/schema/index.js",
      "default": "./dist/lobby/schema/index.js"
    },
    "./schema/aggregator": {
      "types": "./dist/aggregator/schema/index.d.ts",
      "import": "./dist/aggregator/schema/index.js",
      "default": "./dist/aggregator/schema/index.js"
    },
    "./plugins/gaming": {
      "types": "./dist/gaming/plugin.d.ts",
      "import": "./dist/gaming/plugin.js",
      "default": "./dist/gaming/plugin.js"
    },
    "./plugins/lobby": {
      "types": "./dist/lobby/plugin.d.ts",
      "import": "./dist/lobby/plugin.js",
      "default": "./dist/lobby/plugin.js"
    },
    "./plugins/aggregator": {
      "types": "./dist/aggregator/plugin.d.ts",
      "import": "./dist/aggregator/plugin.js",
      "default": "./dist/aggregator/plugin.js"
    },
    "./migrate": {
      "types": "./dist/aggregator/migrate.d.ts",
      "import": "./dist/aggregator/migrate.js",
      "default": "./dist/aggregator/migrate.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:unit": "vitest run --passWithNoTests",
    "test:integration": "vitest run --passWithNoTests",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@orpc/contract": "1.14.5",
    "@orpc/server": "1.14.5",
    "@oss/adapters": "workspace:*",
    "@oss/auth": "workspace:*",
    "@oss/core": "workspace:*",
    "@oss/db": "workspace:*",
    "@oss/plugin-host": "workspace:*",
    "@oss/shared-schemas": "workspace:*",
    "@paralleldrive/cuid2": "3.3.0",
    "drizzle-orm": "0.45.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@oss/tsconfig": "workspace:*",
    "@oss/vitest-config": "workspace:*",
    "@types/node": "25.9.2",
    "drizzle-kit": "0.31.10",
    "typescript": "6.0.3",
    "vitest": "4.1.8"
  }
}
