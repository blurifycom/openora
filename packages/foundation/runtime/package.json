{
  "name": "@oss/runtime",
  "version": "0.2.0",
  "private": false,
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js",
      "default": "./dist/server.js"
    },
    "./plugin-host": {
      "types": "./dist/plugin-host.d.ts",
      "import": "./dist/plugin-host.js",
      "default": "./dist/plugin-host.js"
    },
    "./auth": {
      "types": "./dist/auth.d.ts",
      "import": "./dist/auth.js",
      "default": "./dist/auth.js"
    },
    "./db": {
      "types": "./dist/db.d.ts",
      "import": "./dist/db.js",
      "default": "./dist/db.js"
    },
    "./db/orm": {
      "types": "./dist/db/orm.d.ts",
      "import": "./dist/db/orm.js",
      "default": "./dist/db/orm.js"
    },
    "./migrate": {
      "types": "./dist/migrate.d.ts",
      "import": "./dist/migrate.js",
      "default": "./dist/migrate.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@oss/api-runtime": "workspace:*",
    "@oss/auth": "workspace:*",
    "@oss/core": "workspace:*",
    "@oss/db": "workspace:*",
    "@oss/plugin-host": "workspace:*"
  },
  "devDependencies": {
    "@oss/tsconfig": "workspace:*",
    "@types/node": "25.9.2",
    "typescript": "6.0.3"
  }
}
