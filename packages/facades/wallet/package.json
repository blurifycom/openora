{
  "name": "@oss/wallet",
  "version": "0.1.0",
  "private": false,
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./contracts": {
      "types": "./dist/contracts.d.ts",
      "import": "./dist/contracts.js",
      "default": "./dist/contracts.js"
    },
    "./plugins/wallet": {
      "types": "./dist/plugins/wallet.d.ts",
      "import": "./dist/plugins/wallet.js",
      "default": "./dist/plugins/wallet.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@oss-addons/wallet": "workspace:*"
  },
  "devDependencies": {
    "@oss/tsconfig": "workspace:*",
    "@types/node": "25.9.2",
    "typescript": "6.0.3"
  }
}
