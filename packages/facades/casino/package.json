{
  "name": "@oss/casino",
  "version": "0.1.0",
  "private": false,
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./contracts": {
      "types": "./dist/contracts.d.ts",
      "import": "./dist/contracts.js",
      "default": "./dist/contracts.js"
    },
    "./contracts/aggregator": {
      "types": "./dist/contracts/aggregator.d.ts",
      "import": "./dist/contracts/aggregator.js",
      "default": "./dist/contracts/aggregator.js"
    },
    "./plugins/gaming": {
      "types": "./dist/plugins/gaming.d.ts",
      "import": "./dist/plugins/gaming.js",
      "default": "./dist/plugins/gaming.js"
    },
    "./plugins/lobby": {
      "types": "./dist/plugins/lobby.d.ts",
      "import": "./dist/plugins/lobby.js",
      "default": "./dist/plugins/lobby.js"
    },
    "./plugins/aggregator": {
      "types": "./dist/plugins/aggregator.d.ts",
      "import": "./dist/plugins/aggregator.js",
      "default": "./dist/plugins/aggregator.js"
    },
    "./migrate": {
      "types": "./dist/migrate.d.ts",
      "import": "./dist/migrate.js",
      "default": "./dist/migrate.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@oss-addons/aggregator": "workspace:*",
    "@oss-addons/gaming": "workspace:*",
    "@oss-addons/lobby": "workspace:*"
  },
  "devDependencies": {
    "@oss/tsconfig": "workspace:*",
    "@types/node": "25.9.2",
    "typescript": "6.0.3"
  }
}
