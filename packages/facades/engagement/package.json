{
  "name": "@oss/engagement",
  "version": "0.1.0",
  "private": false,
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./contracts": {
      "types": "./dist/contracts.d.ts",
      "import": "./dist/contracts.js",
      "default": "./dist/contracts.js"
    },
    "./contracts/leaderboard": {
      "types": "./dist/contracts/leaderboard.d.ts",
      "import": "./dist/contracts/leaderboard.js",
      "default": "./dist/contracts/leaderboard.js"
    },
    "./plugins/chat": {
      "types": "./dist/plugins/chat.d.ts",
      "import": "./dist/plugins/chat.js",
      "default": "./dist/plugins/chat.js"
    },
    "./plugins/notifications": {
      "types": "./dist/plugins/notifications.d.ts",
      "import": "./dist/plugins/notifications.js",
      "default": "./dist/plugins/notifications.js"
    },
    "./plugins/bonus": {
      "types": "./dist/plugins/bonus.d.ts",
      "import": "./dist/plugins/bonus.js",
      "default": "./dist/plugins/bonus.js"
    },
    "./plugins/cms": {
      "types": "./dist/plugins/cms.d.ts",
      "import": "./dist/plugins/cms.js",
      "default": "./dist/plugins/cms.js"
    },
    "./plugins/admin-console": {
      "types": "./dist/plugins/admin-console.d.ts",
      "import": "./dist/plugins/admin-console.js",
      "default": "./dist/plugins/admin-console.js"
    },
    "./plugins/leaderboard": {
      "types": "./dist/plugins/leaderboard.d.ts",
      "import": "./dist/plugins/leaderboard.js",
      "default": "./dist/plugins/leaderboard.js"
    },
    "./migrate": {
      "types": "./dist/migrate.d.ts",
      "import": "./dist/migrate.js",
      "default": "./dist/migrate.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@oss-addons/admin-console": "workspace:*",
    "@oss-addons/bonus": "workspace:*",
    "@oss-addons/chat": "workspace:*",
    "@oss-addons/cms": "workspace:*",
    "@oss-addons/leaderboard": "workspace:*",
    "@oss-addons/notifications": "workspace:*"
  },
  "devDependencies": {
    "@oss/tsconfig": "workspace:*",
    "@types/node": "25.9.2",
    "typescript": "6.0.3"
  }
}
