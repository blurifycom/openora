{
  "name": "oss-igaming-platform",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "verify:shape": "tsx tools/verify-module-shape.ts",
    "verify:boundaries": "tsx tools/verify-boundaries.ts",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:unit": "turbo run test:unit",
    "test:integration": "turbo run test:integration",
    "test:e2e": "turbo run test:e2e",
    "db:test:setup": "tsx tools/setup-test-db.ts",
    "codegen": "turbo run codegen",
    "clean": "turbo run clean && rm -rf node_modules",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "sync:agents": "rulesync generate",
    "prepare": "rulesync generate",
    "scaffold": "tsx tools/scaffold.ts",
    "create:app": "tsx tools/create-igaming-app.ts",
    "create:service": "tsx tools/create-service.ts",
    "regen": "turbo run codegen && pnpm -F @oss/db generate && pnpm run gen:catalog",
    "gen:catalog": "tsx tools/gen-catalog.ts",
    "seed": "tsx tools/seed.ts",
    "verify": "turbo run typecheck test:unit && pnpm run lint && pnpm run verify:shape && pnpm run verify:boundaries",
    "verify:drift": "tsx tools/gen-catalog.ts && git diff --exit-code -- docs/catalog.json docs/CATALOG.md",
    "setup:agent": "tsx tools/setup-agent.ts",
    "setup:mcp": "tsx tools/setup-mcp.ts"
  },
  "devDependencies": {
    "@oss/api-runtime": "workspace:*",
    "@oss/auth": "workspace:*",
    "@oss/db": "workspace:*",
    "@types/node": "25.9.0",
    "oxfmt": "0.51.0",
    "oxlint": "^1.64.0",
    "rulesync": "8.25.0",
    "tsx": "4.22.2",
    "turbo": "2.9.14",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@11.1.3"
}
