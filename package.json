{
  "name": "openora",
  "version": "0.0.1",
  "private": true,
  "description": "Open-source, headless, plugin-based, AI-native igaming framework",
  "homepage": "https://github.com/blurifycom/openora",
  "license": "AGPL-3.0-only",
  "author": "Blurify",
  "repository": {
    "type": "git",
    "url": "https://github.com/blurifycom/openora.git"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "clean": "turbo run clean && rm -rf node_modules",
    "verify": "turbo run build check:lint check:format check:boundaries check:shape check:hygiene check:refs check:deprecations test:unit test:integration test:tools && pnpm check:drift && node .rulesync/hooks/guard-mr.mjs --stamp",
    "check:types": "turbo run check:types",
    "check:lint": "oxlint .",
    "check:format": "oxfmt --check",
    "check:boundaries": "depcruise apps packages --config .dependency-cruiser.cjs",
    "check:shape": "tsx tools/lint/verify-module-shape.ts",
    "check:hygiene": "tsx tools/lint/verify-oss-hygiene.ts",
    "check:refs": "tsx tools/lint/verify-references.ts",
    "check:deprecations": "oxlint --type-aware -A all -D typescript/no-deprecated .",
    "check:unused": "knip",
    "check:drift": "tsx tools/gen/sync-tsconfig-paths.ts --check && tsx tools/gen/gen-catalog.ts && rulesync generate && git ls-files --error-unmatch AGENTS.md > /dev/null && git diff --exit-code -- AGENTS.md",
    "fix:lint": "oxlint . --fix",
    "fix:format": "oxfmt && node tools/lint/ensure-final-newline.mjs",
    "test:unit": "turbo run test:unit",
    "test:integration": "turbo run test:integration",
    "test:tools": "node --test \"tools/__tests__/*.test.mjs\"",
    "test:scaffold": "tsx tools/gen/eval-scaffold.ts",
    "report:route-coverage": "tsx tools/lint/report-route-coverage.ts",
    "gen": "tsx tools/gen/gen.ts",
    "gen:catalog": "tsx tools/gen/gen-catalog.ts",
    "gen:dep-graph": "tsx packages/mcp/src/dep-graph-cli.ts packages/mcp/docs/dep-graph.json",
    "gen:drizzle": "pnpm -F @openora/core gen:drizzle",
    "gen:tsconfig": "tsx tools/gen/sync-tsconfig-paths.ts",
    "gen:agents": "rulesync generate",
    "regen": "pnpm run gen:tsconfig && pnpm run gen:drizzle && pnpm run gen:catalog",
    "db:migrate": "openora-migrate",
    "db:seed": "tsx tools/db/seed.ts",
    "db:setup:test": "tsx tools/db/setup-test-db.ts",
    "db:setup:test:fresh": "tsx tools/db/setup-test-db.ts --fresh",
    "db:clean:test": "tsx tools/db/clean-test-databases.ts",
    "create:app": "tsx tools/create/create-igaming-app.ts",
    "create:service": "tsx tools/create/create-service.ts",
    "setup": "tsx tools/setup/setup-agent.ts",
    "setup:mcp": "tsx tools/setup/setup-mcp.ts",
    "prepare": "pnpm run gen:agents && pnpm run gen:catalog && husky",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "2.31.1",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@openora/core": "workspace:*",
    "@openora/testing": "workspace:*",
    "@types/node": "26.6.5",
    "dependency-cruiser": "18.6.0",
    "husky": "9.1.7",
    "knip": "6.42.0",
    "oxfmt": "0.60.0",
    "oxlint": "1.88.0",
    "oxlint-tsgolint": "7.0.2004",
    "pg": "8.23.1",
    "rulesync": "15.1.0",
    "tsx": "4.23.15",
    "turbo": "2.11.9",
    "typescript": "6.0.3",
    "valibot": "1.5.0"
  },
  "engines": {
    "node": ">=26.0.0",
    "pnpm": ">=11.0.0"
  },
  "packageManager": "pnpm@11.8.0"
}
