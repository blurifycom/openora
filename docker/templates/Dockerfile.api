# Consumer API image template.
#
# Build context MUST be the parent directory containing both <consumer>/ and
# casino-oss/. From <consumer>/:
#   docker build -f docker/Dockerfile.api -t <consumer>-api ..
#
# Once @oss/* is on npm, the entire `oss-build` stage disappears and stage 2
# installs deps from the registry. Search for "NPM-ERA" markers below.

ARG NODE_VERSION=22
ARG PNPM_VERSION=10.33.4

# -----------------------------------------------------------------------------
# Stage 1 [NPM-ERA: delete]: vendor casino-oss + build @oss/* packages
# -----------------------------------------------------------------------------
FROM node:${NODE_VERSION}-alpine AS oss-build
ARG PNPM_VERSION
RUN corepack enable && corepack prepare pnpm@${PNPM_VERSION} --activate
WORKDIR /oss

COPY casino-oss/pnpm-lock.yaml casino-oss/pnpm-workspace.yaml casino-oss/package.json casino-oss/tsconfig.base.json ./
COPY casino-oss/apps apps
COPY casino-oss/packages packages
COPY casino-oss/infra infra
COPY casino-oss/tools tools

ENV CI=true
RUN pnpm install --frozen-lockfile --ignore-scripts=false

RUN find packages apps -name 'tsconfig.tsbuildinfo' -delete 2>/dev/null || true \
  && pnpm exec tsx tools/prisma-merge.ts \
  && pnpm -F @oss/infra exec prisma generate \
  && pnpm -F '@oss/api-runtime...' -F '@oss/auth...' -F '@oss/orpc-contract...' build \
  && pnpm -F '@oss/module-*' build

# -----------------------------------------------------------------------------
# Stage 2: install consumer workspace, build consumer plugins, compile config
# -----------------------------------------------------------------------------
FROM oss-build AS app-build
WORKDIR /app

# Consumer manifest + lockfile + source
COPY <consumer>/pnpm-lock.yaml <consumer>/pnpm-workspace.yaml <consumer>/package.json ./
COPY <consumer>/apps apps
COPY <consumer>/plugins plugins
COPY <consumer>/extensions.config.ts ./
COPY <consumer>/infra infra

# [NPM-ERA: delete] pnpm `link:` overrides are workspace-relative, not absolute.
# Symlink /oss as a sibling of /app so the existing `link:../casino-oss/...`
# overrides resolve correctly inside the image.
RUN ln -sfn /oss /casino-oss

RUN pnpm install --frozen-lockfile=false --ignore-scripts=false

RUN find . -name 'tsconfig.tsbuildinfo' -delete 2>/dev/null || true \
  && pnpm -r build \
  && pnpm exec tsc \
       --module ESNext \
       --moduleResolution Bundler \
       --target ES2022 \
       --outDir . \
       --skipLibCheck \
       extensions.config.ts

# -----------------------------------------------------------------------------
# Stage 3: runtime
# -----------------------------------------------------------------------------
FROM node:${NODE_VERSION}-alpine AS runtime
ARG PNPM_VERSION
RUN corepack enable && corepack prepare pnpm@${PNPM_VERSION} --activate
WORKDIR /app

ENV NODE_ENV=production
ENV PORT=3001

# [NPM-ERA: only need /app] Copy both /oss (vendored OSS) and /app (consumer).
COPY --from=app-build /oss /oss
COPY --from=app-build /app /app

# Apply DB schema on boot. Override PRISMA_DIR to point at YOUR migrations
# instead of the OSS-merged schema if your consumer has its own.
COPY casino-oss/docker/api-entrypoint.sh /usr/local/bin/api-entrypoint
RUN chmod +x /usr/local/bin/api-entrypoint
ENV PRISMA_DIR=/oss/infra

EXPOSE 3001
HEALTHCHECK --interval=15s --timeout=3s --start-period=30s --retries=10 \
  CMD wget -qO- "http://localhost:${PORT}/health" >/dev/null || exit 1

ENTRYPOINT ["/usr/local/bin/api-entrypoint"]
CMD ["node", "apps/api/dist/main.js"]
