# Consumer Web image template (optional - only if the consumer ships a Next.js
# app alongside the API).
#
# Build context MUST be the parent directory containing both <consumer>/ and
# casino-oss/. From <consumer>/:
#   docker build -f docker/Dockerfile.web -t <consumer>-web ..
#
# Requires `output: 'standalone'` in apps/web/next.config.ts and a
# `transpilePackages` entry for every linked @oss/* UI package.

ARG NODE_VERSION=22
ARG PNPM_VERSION=10.33.4

# -----------------------------------------------------------------------------
# Stage 1 [NPM-ERA: delete]: build the @oss/* UI packages we link to
# -----------------------------------------------------------------------------
FROM node:${NODE_VERSION}-alpine AS oss-build
ARG PNPM_VERSION
RUN corepack enable && corepack prepare pnpm@${PNPM_VERSION} --activate
WORKDIR /oss

COPY casino-oss/pnpm-lock.yaml casino-oss/pnpm-workspace.yaml casino-oss/package.json casino-oss/tsconfig.base.json ./
COPY casino-oss/apps apps
COPY casino-oss/packages packages
COPY casino-oss/infra infra
COPY casino-oss/tools tools

ENV CI=true
RUN pnpm install --frozen-lockfile --ignore-scripts=false

RUN find packages apps -name 'tsconfig.tsbuildinfo' -delete 2>/dev/null || true \
  && pnpm -F @oss/ui-provider-contract -F @oss/ui-provider-shadcn \
         -F @oss/design-system -F @oss/react-sdk build

# -----------------------------------------------------------------------------
# Stage 2: next build apps/web
# -----------------------------------------------------------------------------
FROM oss-build AS web-build
WORKDIR /app

COPY <consumer>/pnpm-lock.yaml <consumer>/pnpm-workspace.yaml <consumer>/package.json ./
COPY <consumer>/apps apps
COPY <consumer>/plugins plugins

RUN ln -sfn /oss /casino-oss

RUN pnpm install --frozen-lockfile=false --ignore-scripts=false

# Tracing root is `/` so Next follows symlinks into the sibling /oss workspace.
# (NPM-ERA: set to /app once @oss/* comes from the npm registry inside /app.)
ENV NEXT_TELEMETRY_DISABLED=1
ENV NEXT_OUTPUT_FILE_TRACING_ROOT=/
RUN pnpm -F @<consumer>/web exec next build

# -----------------------------------------------------------------------------
# Stage 3: minimal runtime (Next standalone)
# -----------------------------------------------------------------------------
FROM node:${NODE_VERSION}-alpine AS runtime
WORKDIR /app

ENV NODE_ENV=production
ENV PORT=3100
ENV HOSTNAME=0.0.0.0

# With NEXT_OUTPUT_FILE_TRACING_ROOT=/, standalone bundle preserves the full
# `/app/apps/web/` path. Copy from / so paths line up.
COPY --from=web-build /app/apps/web/.next/standalone/ /
COPY --from=web-build /app/apps/web/.next/static /app/apps/web/.next/static
RUN mkdir -p /app/apps/web/public

WORKDIR /app
EXPOSE 3100
CMD ["node", "apps/web/server.js"]
