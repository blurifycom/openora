{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "jsPlugins": [
    "./tools/lint/oxlint-boundaries-plugin.mjs",
    "./tools/lint/oxlint-module-shape-plugin.mjs"
  ],
  "plugins": ["unicorn", "typescript", "oxc", "import"],
  "rules": {
    "import/no-cycle": [
      "error",
      {
        "ignoreTypes": false
      }
    ],
    "no-unused-vars": "warn",
    "no-console": "warn",
    "eqeqeq": "error",
    "no-var": "error",
    "prefer-const": "error",
    "typescript/no-explicit-any": "error",
    "unicorn/filename-case": ["error", { "case": "kebabCase" }],
    "oss-boundaries/no-adhoc-zod-in-router": "error",
    "oss-boundaries/no-core-to-addon": "error",
    "oss-boundaries/no-cross-addon": "error",
    "oss-boundaries/no-contracts-to-runtime": "error",
    "oss-boundaries/no-module-contract-to-runtime": "error",
    "oss-boundaries/no-react-to-runtime": "error",
    "oss-boundaries/no-deep-dist-import": "error",
    "oss-boundaries/no-cross-core-domain": "error",
    "oss-boundaries/no-engine-to-domain": "error",
    "oss-module-shape/module-file-placement": "error",
    "oss-module-shape/layer-file-naming": "error",
    "oss-module-shape/no-inline-pg-enum": "error",
    "oss-module-shape/no-relative-zone-escape": "error",
    "typescript/consistent-type-definitions": ["error", "type"],
    "import/no-duplicates": "error"
  },
  "ignorePatterns": [
    "**/node_modules*/**",
    "dist",
    ".next",
    ".turbo",
    "coverage",
    "generated",
    "*.generated.ts",
    "tools/templates"
  ],
  "overrides": [
    {
      "files": ["*.test.ts", "*.spec.ts"],
      "rules": {
        "typescript/no-explicit-any": "off",
        "unicorn/no-thenable": "off",
        "oss-boundaries/no-cross-addon": "off",
        "oss-boundaries/no-cross-core-domain": "off"
      }
    },
    {
      "files": ["tools/**", "**/scripts/**"],
      "rules": {
        "no-console": "off"
      }
    }
  ]
}
