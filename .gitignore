*.tsbuildinfo
.pnpm-store
# OpenAPI spec is generated, not committed. Emitted by `pnpm gen:openapi`
# and on API boot. Read by gen-catalog + the @openora/mcp query-openapi
# tool, which regenerate/expect it locally (pnpm setup runs regen).
docs/openapi.json
apps/*/docs/openapi.json
.cache
# TanStack Router file-based route tree (generated by tsr generate / vite plugin)
routeTree.gen.ts
# TanStack Router plugin cache
.tanstack

# AI-agent instruction files - ALL generated, never commit. Regenerated on
# `pnpm install` (prepare) or `pnpm gen:agents`; nested CLAUDE.md stubs by
# tools/gen/gen-claude-stubs.mjs. Never hand-write a CLAUDE.md anywhere (git
# silently skips it) - module docs belong in the module's committed AGENTS.md.
# AGENTS.md is root-anchored so per-package AGENTS.md (hand-written) stay tracked.
# CLAUDE.md is NOT anchored: every per-module CLAUDE.md is a generated `@AGENTS.md`
# redirect stub, so none of them belong in git at any depth.
CLAUDE.md
/AGENTS.md
/.mcp.json
.vscode/mcp.json
.codex/
.agents/
.claude/*
!.claude/settings.json
.github/*
!.github/workflows/
!.github/actions/
!.github/ISSUE_TEMPLATE/
!.github/pull_request_template.md
