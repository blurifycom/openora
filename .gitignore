routeTree.gen.ts
# TanStack Router plugin cache
.tanstack

# AI-agent instruction files - ALL generated, never commit. Regenerated on
# `pnpm install` (prepare) or `pnpm gen:agents`. Never hand-write a CLAUDE.md
# anywhere; root instructions are generated from `.rulesync/`.
CLAUDE.md
/AGENTS.md
/.mcp.json
