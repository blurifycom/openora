{
  "name": "minimal-igaming",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --import tsx --watch --env-file-if-exists=.env src/main.ts",
    "start": "node --import tsx src/main.ts",
    "typecheck": "tsc --noEmit",
    "build:oss": "pnpm -C ../igaming-oss -F '@oss/api-runtime...' -F '@oss/orpc-contract...' -F '@oss/react-sdk...' -F '@oss/ui-provider-shadcn...' build && pnpm -C ../igaming-oss -F '@oss/modules' build"
  },
  "dependencies": {
    "@oss/api-runtime": "link:../igaming-oss/packages/platform/api-runtime",
    "@oss/orpc-contract": "link:../igaming-oss/packages/contracts/orpc-contract",
    "@oss/plugin-host": "link:../igaming-oss/packages/platform/plugin-host",
    "@oss/adapters": "link:../igaming-oss/packages/contracts/adapters",
    "@oss/shared-schemas": "link:../igaming-oss/packages/contracts/shared-schemas",
    "reflect-metadata": "0.2.2"
  },
  "devDependencies": {
    "@oss/tsconfig": "link:../igaming-oss/packages/config/tsconfig",
    "@types/node": "25.9.1",
    "tsx": "4.22.3",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.33.4",
  "pnpm": {
    "overrides": {
      "@oss/api-runtime": "link:../igaming-oss/packages/platform/api-runtime",
      "@oss/auth": "link:../igaming-oss/packages/platform/auth",
      "@oss/plugin-host": "link:../igaming-oss/packages/platform/plugin-host",
      "@oss/core": "link:../igaming-oss/packages/platform/core",
      "@oss/db": "link:../igaming-oss/packages/platform/db",
      "@oss/orpc-contract": "link:../igaming-oss/packages/contracts/orpc-contract",
      "@oss/adapters": "link:../igaming-oss/packages/contracts/adapters",
      "@oss/shared-schemas": "link:../igaming-oss/packages/contracts/shared-schemas",
      "@oss/tsconfig": "link:../igaming-oss/packages/config/tsconfig",
      "@oss/react-sdk": "link:../igaming-oss/packages/sdks/react-sdk",
      "@oss/ui-provider-contract": "link:../igaming-oss/packages/ui/provider-contract",
      "@oss/ui-provider-shadcn": "link:../igaming-oss/packages/ui/provider-shadcn"
    }
  }
}
