# `pnpm verify` is check-only - nothing in it rewrites a file. Re-add the staged
# set anyway so a fix applied by hand mid-gate lands in this commit, and only
# that set, so unrelated unstaged work is never dragged in.
staged=$(git diff --cached --name-only --diff-filter=ACMR)

pnpm verify

if [ -n "$staged" ]; then
  printf '%s\n' "$staged" | tr '\n' '\0' | xargs -0 git add --
fi
