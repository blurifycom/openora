{
  "permissions": {
    "deny": [
      "Bash(git reset --hard *)",
      "Bash(npm *)",
      "Bash(yarn *)"
    ]
  },
  "enableAllProjectMcpServers": false,
  "enabledMcpjsonServers": [
    "oss-dev"
  ],
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .rulesync/hooks/guard-generated.mjs"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .rulesync/hooks/post-edit.mjs"
          }
        ]
      }
    ]
  }
}
