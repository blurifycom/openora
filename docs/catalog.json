    {
      "category": "notification",
      "interface": "NotificationDeliveryAdapter",
      "token": "NOTIFICATION_DELIVERY_ADAPTER",
      "status": "wired",
      "boundIn": [
        "packages/modules/platform/identity/src/plugin.ts",
        "packages/modules/platform/notifications/src/plugin.ts"
      ]
    },
    {
      "category": "payment",
      "interface": "PaymentAdapter",
      "token": "PAYMENT_ADAPTER",
      "status": "wired",
      "boundIn": [
        "packages/modules/player/wallet/src/plugin.ts"
      ]
    },
    {
      "category": "realtime",
      "interface": "RealtimePresence",
      "token": "REALTIME_TRANSPORT",
      "status": "wired",
      "boundIn": [
        "packages/modules/player/chat/src/plugin.ts",
        "packages/modules/player/sportsbook/src/plugin.ts"
      ]
    },
    {
      "category": "rng",
      "interface": "RngAdapter",
      "token": "RNG_ADAPTER",
      "status": "wired",
      "boundIn": [
        "packages/modules/player/gaming/src/plugin.ts"
      ]
