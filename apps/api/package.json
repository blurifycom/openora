{
  "name": "@blurifycom/api",
  "version": "0.3.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "node --import tsx --watch src/main.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "codegen": "tsx src/emit-openapi.ts",
    "test": "vitest run",
    "test:integration": "vitest run -c vitest.integration.config.ts"
  },
  "dependencies": {
    "@blurifycom/core": "workspace:*",
    "@orpc/contract": "1.14.5",
    "@orpc/server": "1.14.5",
    "amqplib": "2.0.1",
    "bullmq": "5.78.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@better-auth/utils": "0.4.1",
    "@blurifycom/testing": "workspace:*",
    "@blurifycom/vitest-config": "workspace:*",
    "tsx": "4.22.4",
    "typescript": "6.0.3",
    "vitest": "4.1.8"
  }
}
