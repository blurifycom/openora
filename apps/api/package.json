{
  "name": "@oss/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "node --import tsx --watch src/main.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "codegen": "tsx src/emit-openapi.ts",
    "test": "vitest run",
    "test:integration": "vitest run -c vitest.integration.config.ts"
  },
  "dependencies": {
    "@orpc/server": "1.14.5",
    "@oss/adapters": "workspace:*",
    "@oss/api-runtime": "workspace:*",
    "@oss/core": "workspace:*",
    "@oss/orpc-contract": "workspace:*",
    "@oss/plugin-host": "workspace:*",
    "@oss/shared-schemas": "workspace:*",
    "amqplib": "2.0.1",
    "bullmq": "5.78.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@better-auth/utils": "0.4.1",
    "@oss/modules": "workspace:*",
    "@oss/testing": "workspace:*",
    "@oss/tsconfig": "workspace:*",
    "@oss/vitest-config": "workspace:*",
    "tsx": "4.22.4",
    "typescript": "6.0.3",
    "vitest": "4.1.8"
  }
}
