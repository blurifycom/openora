{
  "name": "@openora/docs",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "docs:gen": "tsx ../../tools/gen/gen-docs-content.ts && tsx scripts/generate-openapi.ts",
    "dev": "pnpm run docs:gen && next dev",
    "build": "pnpm run docs:gen && next build",
    "start": "serve out",
    "typecheck": "pnpm run docs:gen && next typegen && fumadocs-mdx && tsc --noEmit"
  },
  "dependencies": {
    "@orama/orama": "3.1.18",
    "fumadocs-core": "16.10.5",
    "fumadocs-mdx": "15.0.12",
    "fumadocs-openapi": "11.0.3",
    "fumadocs-ui": "16.10.5",
    "mermaid": "11.15.0",
    "next": "16.2.9",
    "next-themes": "0.4.6",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-zoom-pan-pinch": "4.0.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.1",
    "@types/mdx": "2.0.14",
    "@types/node": "25.9.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "postcss": "8.5.15",
    "serve": "14.2.6",
    "tailwindcss": "4.3.1",
    "tsx": "4.22.4",
    "typescript": "6.0.3"
  }
}
