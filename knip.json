{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["extensions.config.ts", ".rulesync/hooks/*.mjs"],
      "ignore": ["tools/templates/**"],
      "ignoreDependencies": ["valibot", "vite"]
    },
    "packages/core": {
      "entry": [
        "src/**/drizzle.config.ts",
        "src/{compliance,casino/*,engagement/*,fx/*,pam/*,promo/*,sportsbook/*}/index.ts",
        "src/**/__tests__/fixtures/**/*.ts",
        "vitest.mutation.config.ts"
      ],
      "ignoreDependencies": ["naughty-words", "react"]
    }
  }
}
