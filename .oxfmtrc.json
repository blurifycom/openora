{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": true,
  "singleQuote": true,
  "trailingComma": "all",
  "printWidth": 100,
  "tabWidth": 2,
  "ignorePatterns": [
    "**/node_modules/**",
    "**/dist/**",
    "**/.next/**",
    "**/coverage/**",
    "**/generated/**",
    "**/*.hbs",
    "**/catalog.json",
    "docs/openapi.json",
    "packages/core/drizzle/migrations/**",
    "pnpm-lock.yaml"
  ]
}
