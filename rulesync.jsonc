// rulesync config - single source of truth for all AI-agent instruction files.
// Source lives in .rulesync/ (rules, subagents, commands, mcp.json).
// Regenerate with `pnpm gen:agents`; `pnpm check:drift` catches a stale commit.
{
  "$schema": "https://github.com/dyoshikawa/rulesync/releases/latest/download/config-schema.json",

  // Agents this repo targets, with per-target features. agentsmd is rules-only so
  // AGENTS.md stays a clean human brief (no simulated-command boilerplate).
  // hooks: generated from .rulesync/hooks.json (-> .rulesync/hooks/*.mjs).
  // Claude's hooks stay hand-written in .claude/settings.json (which also holds
  // enabledMcpjsonServers - not in rulesync's model), pointing at the same .mjs scripts.
  // permissions are NOT managed here for claudecode (hand-kept in settings.json).
  // Per-target feature support (project mode, not just global) per rulesync's
  // supported-tools reference for the installed version - re-check there before
  // adding a feature back:
  //   codexcli: no "ignore"; "commands" is global-mode only (we don't run --global).
  "targets": {
    "agentsmd": ["rules"],
    "claudecode": [
      "rules",
      "mcp",
      "subagents",
      "commands",
      "skills",
      "hooks",
      "permissions",
      "ignore",
    ],
    "codexcli": ["rules", "mcp", "subagents", "skills", "hooks", "permissions"],
  },

  // Off: keeps AGENTS.md free of simulated-command and simulated-subagent boilerplate.
  "simulateCommands": false,
  "simulateSubagents": false,

  // Remove a mirror whose source left .rulesync/ (a renamed or deleted skill or
  // subagent). rulesync deletes only files it recognises as its own output;
  // .github workflows and .claude/settings.json are never touched (verified with
  // `rulesync generate --delete --dry-run`).
  "delete": true,
}
